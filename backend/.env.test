# Dùng bởi vitest.config.ts (npm test) — trỏ vào MySQL Docker riêng cho test
# (docker-compose.test.yml, port 3307), KHÔNG phải DB dev ở .env (port 3306). An toàn
# để commit: toàn bộ giá trị bên dưới là fake/test-only, không phải secret thật.
NODE_ENV=test
PORT=4001

DATABASE_URL="mysql://root:test@localhost:3307/techpulse_test"

CLIENT_URL=http://localhost:3000

JWT_ACCESS_SECRET=5fbbe3f3c0a065834f3229150aa5c9683307b6f62f9ca089fc27d8a6e8f4af6f
JWT_REFRESH_SECRET=3fe1dfbbaa33a42a0102de30222ea61b34ec5e1bd70150e8ecdee9625f488ba6
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Thấp hơn mặc định (12) để test chạy nhanh hơn — vẫn thoả min(10) của env schema.
BCRYPT_SALT_ROUNDS=10

# Không có test nào thật sự gọi Cloudinary/SMTP/VNPay (mock ở boundary utils/*.ts) —
# giá trị dưới đây chỉ để env.ts (zod) không process.exit(1) vì thiếu field required.
CLOUDINARY_CLOUD_NAME=test
CLOUDINARY_API_KEY=test
CLOUDINARY_API_SECRET=test

VNPAY_TMN_CODE=test
VNPAY_HASH_SECRET=test-vnpay-hash-secret
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:4001/api/v1/payments/vnpay/return

SMTP_HOST=smtp.test.local
SMTP_PORT=587
SMTP_USER=test@test.local
SMTP_PASS=test
SMTP_FROM=
