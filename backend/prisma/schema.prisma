generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum VoteType {
  UPVOTE
  DOWNVOTE
}

enum NotificationType {
  NEW_COMMENT
  NEW_REPLY
  NEW_VOTE
  SYSTEM
}

enum OrderStatus {
  PENDING_PAYMENT
  CONFIRMED
  SHIPPING
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  COD
  VNPAY
}

enum PaymentStatus {
  UNPAID
  PAID
  FAILED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String
  avatarUrl    String?  @map("avatar_url")
  bio          String?  @db.Text
  role         Role     @default(USER)
  isVerified   Boolean  @default(false) @map("is_verified")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  reviews               Review[]
  comments              Comment[]
  votes                 Vote[]
  notificationsReceived Notification[] @relation("NotificationRecipient")
  notificationsSent     Notification[] @relation("NotificationActor")
  refreshTokens         RefreshToken[]
  otpCodes              OtpCode[]
  cartItems             CartItem[]
  orders                Order[]

  @@map("users")
}

model Product {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String   @db.Text
  imageUrl    String?  @map("image_url")
  brand       String?
  category    String
  // VND, whole-dong integer — no minor unit exists for VND, so no Decimal needed.
  // Defaulted (not just required) so adding this column stays additive: existing
  // seeded rows don't need a destructive migrate reset to satisfy a NOT NULL add.
  price       Int      @default(0)
  // Giá niêm yết trước giảm — optional (NULL nghĩa là không giảm giá). Chỉ hiện badge
  // %/giá gạch ngang ở ProductCard khi originalPrice > price (xem productService).
  originalPrice Int?   @map("original_price")
  // Hard-blocks at 0 (no backorder) — checked/decremented atomically at order time,
  // see productRepository.decrementStock.
  stock       Int      @default(0)
  // Mảng { label, value } có thứ tự hiển thị (không phải object key-value) — khác
  // category/brand nên không cố định field cứng: Smartphone cần "Chip"/"RAM", Đồng hồ cần
  // "Chuẩn kết nối"... admin tự đặt tên thông số phù hợp từng sản phẩm (xem
  // AdminProductForm.tsx). NULL/[] đều hợp lệ — ProductDetail chỉ hiện bảng khi có dữ liệu.
  specifications Json?
  // Denormalized aggregates — kept in sync by the review service on
  // create/update/delete, not enforced by the database itself.
  avgRating   Float    @default(0) @map("avg_rating")
  reviewCount Int      @default(0) @map("review_count")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  reviews    Review[]
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@index([category])
  @@index([brand])
  @@map("products")
}

model Review {
  id            String   @id @default(cuid())
  title         String
  content       String   @db.Text
  rating        Int
  userId        String   @map("user_id")
  productId     String   @map("product_id")
  // Denormalized, giữ đồng bộ bởi voteService mỗi khi vote thay đổi (cùng lý do với
  // Product.avgRating/reviewCount) — cho phép ORDER BY điểm số mà không phải COUNT
  // votes mỗi lần list.
  upvoteCount   Int      @default(0) @map("upvote_count")
  downvoteCount Int      @default(0) @map("downvote_count")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  product       Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  comments      Comment[]
  votes         Vote[]
  notifications Notification[]

  @@index([productId, createdAt])
  @@index([userId])
  @@map("reviews")
}

model Comment {
  id        String   @id @default(cuid())
  content   String   @db.Text
  userId    String   @map("user_id")
  reviewId  String   @map("review_id")
  parentId  String?  @map("parent_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  review        Review         @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  parent        Comment?       @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies       Comment[]      @relation("CommentReplies")
  notifications Notification[]

  @@index([reviewId])
  @@index([parentId])
  @@index([userId])
  @@map("comments")
}

model Vote {
  id        String   @id @default(cuid())
  type      VoteType
  userId    String   @map("user_id")
  reviewId  String   @map("review_id")
  createdAt DateTime @default(now()) @map("created_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@unique([reviewId, userId])
  @@index([userId])
  @@map("votes")
}

// Enables real revocation of a stateless JWT refresh token: the signed token itself
// is never stored (only its hash, same reasoning as passwordHash — a DB leak must not
// hand out directly-usable tokens), and revoking is just flipping revokedAt instead of
// deleting, so a revoked-token reuse attempt can still be detected (see authService.refresh).
model RefreshToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique @map("token_hash")
  userId    String    @map("user_id")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

// Mã OTP xác thực email sau đăng ký. codeHash KHÔNG @unique (khác RefreshToken.tokenHash)
// vì mã 6 chữ số chỉ có 1 triệu giá trị khả dĩ — trùng nhau giữa các user khác nhau là
// bình thường, tính duy nhất chỉ có ý nghĩa trong phạm vi 1 userId. "Mã đang hiệu lực"
// của 1 user = row consumedAt=null mới nhất (xem otpRepository.findLatestActiveForUser).
model OtpCode {
  id         String    @id @default(cuid())
  userId     String    @map("user_id")
  codeHash   String    @map("code_hash")
  attempts   Int       @default(0)
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("otp_codes")
}

model Notification {
  id          String           @id @default(cuid())
  type        NotificationType
  message     String           @db.Text
  isRead      Boolean          @default(false) @map("is_read")
  recipientId String           @map("recipient_id")
  actorId     String?          @map("actor_id")
  reviewId    String?          @map("review_id")
  commentId   String?          @map("comment_id")
  createdAt   DateTime         @default(now()) @map("created_at")

  recipient User     @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  actor     User?    @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  review    Review?  @relation(fields: [reviewId], references: [id], onDelete: SetNull)
  comment   Comment? @relation(fields: [commentId], references: [id], onDelete: SetNull)

  @@index([recipientId, isRead, createdAt])
  @@map("notifications")
}

// Đăng ký nhận tin khuyến mãi (popup trang chủ) — KHÔNG liên kết User: khách chưa có
// tài khoản vẫn để lại email được, và 1 User cũng không bắt buộc phải đăng ký nhận tin.
model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  phone     String?
  createdAt DateTime @default(now()) @map("created_at")

  @@map("newsletter_subscribers")
}

// Không có model Cart riêng: "1 giỏ hàng / user" đã được diễn đạt đủ bằng
// @@unique([userId, productId]) — thêm 1 bảng Cart header chỉ để giữ userId là thừa (YAGNI).
model CartItem {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  productId String   @map("product_id")
  quantity  Int
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
  @@map("cart_items")
}

model Order {
  id            String        @id @default(cuid())
  userId        String        @map("user_id")
  status        OrderStatus   @default(PENDING_PAYMENT)
  paymentMethod PaymentMethod @map("payment_method")
  paymentStatus PaymentStatus @default(UNPAID) @map("payment_status")
  // VND, tổng đã snapshot tại thời điểm đặt hàng — không đổi theo Product.price sau này.
  totalAmount   Int           @map("total_amount")

  // Snapshot thông tin giao hàng ngay trên Order — không tách model Address riêng
  // (checkout 1 lần/order, không có khái niệm "sổ địa chỉ" — YAGNI).
  recipientName   String  @map("recipient_name")
  recipientPhone  String  @map("recipient_phone")
  shippingAddress String  @db.Text @map("shipping_address")
  note            String? @db.Text

  // VNPay bookkeeping. vnpTxnRef là mã tham chiếu của LẦN THỬ THANH TOÁN HIỆN TẠI —
  // retry sau khi thanh toán thất bại ghi đè giá trị này (không tạo Order mới), vì
  // Order đã đại diện đúng ý định mua hàng (đã chốt giá, đã chốt địa chỉ giao).
  vnpTxnRef       String?   @unique @map("vnp_txn_ref")
  paymentAttempts Int       @default(0) @map("payment_attempts")
  paidAt          DateTime? @map("paid_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user  User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  items OrderItem[]

  @@index([userId, createdAt])
  @@map("orders")
}

model OrderItem {
  id      String @id @default(cuid())
  orderId String @map("order_id")
  // Nullable + onDelete: SetNull — order lịch sử vẫn còn đủ thông tin (đã snapshot
  // bên dưới) kể cả khi Product gốc bị xoá sau này.
  productId String? @map("product_id")
  // Snapshot tại thời điểm mua — cùng triết lý denormalize như Product.avgRating/
  // Review.upvoteCount: giá/tên Product có thể đổi sau, đơn hàng cũ không được đổi theo.
  productName String  @map("product_name")
  price       Int
  quantity    Int
  imageUrl    String? @map("image_url")

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}
