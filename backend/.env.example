NODE_ENV=development
PORT=4000

# MySQL connection string used by Prisma
DATABASE_URL="mysql://root:password@localhost:3306/techpulse"

# Frontend origin allowed by CORS + Socket.IO (production: your Vercel URL)
CLIENT_URL=http://localhost:3000

# Generate strong random secrets, e.g.: openssl rand -base64 48
JWT_ACCESS_SECRET=change-this-to-a-random-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-this-to-a-different-random-secret-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

BCRYPT_SALT_ROUNDS=12

# From your Cloudinary dashboard (console.cloudinary.com)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
